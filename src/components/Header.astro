---
import { Image } from 'astro:assets';
import logo from '../assets/brand/thrive-logo-light.png';
import Icon from './Icon.astro';

interface Props { path: string }
const { path } = Astro.props;

const nav = [
  { href: '/hospital', label: 'Plant Hospital' },
  { href: '/shop', label: 'Shop' },
  { href: '/business', label: 'For Business' },
  { href: '/vouchers', label: 'Gift Vouchers' },
  { href: '/about', label: 'About' },
];
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="site-header">
  <div class="wrap inner">
    <a href="/" class="brand" aria-label="thrive plants bristol, home">
      {/* The cream-ink version of the logo, made for dark backgrounds.
          [PLACEHOLDER] A temporary redraw until Mandie sends her own file. */}
      <Image src={logo} alt="" height={100} widths={[100, 200]} sizes="100px" class="logo" loading="eager" />
      <span class="sub">plants bristol</span>
    </a>

    <nav class="main-nav" aria-label="Main">
      {nav.map((n) => <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>)}
    </nav>

    <div class="actions">
      <a href="/basket" class="basket" aria-label="Basket" data-basket-link hidden>
        <Icon name="shopping-bag" size={22} />
        <span class="count" data-basket-count>0</span>
      </a>
      <a href="/book" class="btn btn-sm">Book in</a>
      <button class="menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
        <span class="open"><Icon name="menu" size={26} /></span>
        <span class="close"><Icon name="x" size={26} /></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav aria-label="Mobile">
      <a href="/">Home</a>
      {nav.map((n) => <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>)}
      <a href="/contact">Contact</a>
      <a href="/book" class="btn btn-block">Book your plant in</a>
    </nav>
  </div>
</header>

<script>
  import { count, subscribe } from '../lib/basket';

  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;
  function setMenu(open: boolean) {
    menu.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.body.style.overflow = open ? 'hidden' : '';
  }
  toggle.addEventListener('click', () => setMenu(menu.hidden));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) setMenu(false); });

  /* The basket icon only appears once there is something in it. An empty
     basket icon on a site that is mostly a plant hospital just raises the
     question "what would I buy here?" before they have seen the shop. */
  const link = document.querySelector<HTMLElement>('[data-basket-link]')!;
  const badge = document.querySelector<HTMLElement>('[data-basket-count]')!;
  const render = () => {
    const n = count();
    link.hidden = n === 0;
    badge.textContent = String(n);
  };
  render();
  subscribe(render);
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .inner { height: var(--header-h); display: flex; align-items: center; gap: 24px; }
  .brand { display: flex; align-items: flex-end; gap: 8px; text-decoration: none; flex-shrink: 0; }
  .brand :global(.logo) { height: 50px; width: auto; }
  .sub { font-family: var(--display); font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-soft); padding-bottom: 6px; }

  .main-nav { display: flex; gap: 4px; margin-left: auto; }
  .main-nav a {
    font-family: var(--display); font-size: 0.95rem; letter-spacing: 0.08em; text-transform: uppercase;
    text-decoration: none; padding: 0.5em 0.8em;
  }
  .main-nav a:hover, .main-nav a[aria-current='page'] { color: var(--lime); }

  .actions { display: flex; align-items: center; gap: 10px; }
  .basket { position: relative; display: grid; place-items: center; width: 44px; height: 44px; color: var(--ink); }
  .count {
    position: absolute; top: 2px; right: 0; min-width: 18px; height: 18px; padding: 0 4px;
    background: var(--lime); color: var(--on-lime); font-size: 0.72rem; font-weight: 600;
    display: grid; place-items: center; border-radius: 9px;
  }

  .menu-toggle { display: none; width: 46px; height: 46px; border: 0; background: transparent; align-items: center; justify-content: center; }
  .menu-toggle .close { display: none; }
  .menu-toggle[aria-expanded='true'] .open { display: none; }
  .menu-toggle[aria-expanded='true'] .close { display: block; }

  .mobile-menu {
    position: fixed; inset: var(--header-h) 0 0 0; z-index: 49;
    background: var(--bg); padding: 24px 16px 48px; overflow-y: auto;
  }
  .mobile-menu nav { display: flex; flex-direction: column; }
  .mobile-menu a:not(.btn) {
    font-family: var(--display); font-weight: 600; text-transform: uppercase;
    font-size: 2rem; line-height: 1.1; text-decoration: none; padding: 0.35em 0;
    border-bottom: 1px solid var(--line);
  }
  .mobile-menu a[aria-current='page'] { color: var(--lime); }
  .mobile-menu .btn { margin-top: 24px; }

  @media (max-width: 1020px) {
    .main-nav { display: none; }
    .actions { margin-left: auto; }
    .menu-toggle { display: inline-flex; }
  }
  @media (max-width: 560px) {
    .brand :global(.logo) { height: 40px; }
    .sub { display: none; }
  }
</style>
