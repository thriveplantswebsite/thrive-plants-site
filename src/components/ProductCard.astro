---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatPrice } from '../lib/shop';
import BasketButton from './BasketButton.astro';

interface Props { product: CollectionEntry<'products'>; comingSoon: boolean; priority?: boolean }
const { product, comingSoon, priority = false } = Astro.props;
const p = product.data;
const first = p.images[0];
const sold = p.status === 'sold';
---
<article class="product" data-product={product.id} data-sold={sold ? 'true' : undefined}>
  <a href={`/shop/${product.id}`} class="img">
    <Image
      src={first.image}
      alt={first.alt || p.title}
      widths={[300, 500, 800]}
      sizes="(max-width: 700px) 50vw, (max-width: 1020px) 33vw, 25vw"
      loading={priority ? 'eager' : 'lazy'}
    />
    <span class="badges">
      {p.easyCare && <span class="badge">Easy care</span>}
      {p.petSafe && <span class="badge">Pet safe</span>}
    </span>
    <span class="rehomed">Rehomed</span>
  </a>
  <h3><a href={`/shop/${product.id}`}>{p.title}</a></h3>
  {p.pot && <p class="pot">{p.pot}</p>}
  <div class="foot">
    <b>{formatPrice(p.price)}</b>
    <BasketButton id={product.id} comingSoon={comingSoon} sold={sold} compact />
  </div>
</article>

<style>
  .product { display: flex; flex-direction: column; }
  .img {
    position: relative; display: block; aspect-ratio: 1 / 1.12;
    background: var(--surface); padding: 10%; margin-bottom: 1rem; overflow: hidden;
  }
  .img :global(img) { width: 100%; height: 100%; object-fit: contain; transition: transform .35s var(--ease); filter: drop-shadow(0 14px 14px rgba(0,0,0,.35)); }
  .product:hover .img :global(img) { transform: scale(1.05) rotate(-1deg); }
  .badges { position: absolute; top: 12px; left: 12px; display: flex; flex-wrap: wrap; gap: 6px; }
  .badge {
    background: var(--lime); color: var(--on-lime); font-family: var(--display); font-size: .72rem;
    letter-spacing: .08em; text-transform: uppercase; padding: 4px 9px;
  }
  /* "Rehomed", not "Sold": every pot here is a rescue, and the word keeps
     the sold ones on the page as proof the shop moves, rather than as
     disappointment. */
  .rehomed {
    display: none; position: absolute; inset: auto 12px 12px auto;
    background: var(--ink); color: var(--bg); font-family: var(--display); font-size: .8rem;
    letter-spacing: .1em; text-transform: uppercase; padding: 5px 10px;
  }
  .product[data-sold] .rehomed { display: block; }
  .product[data-sold] .img :global(img) { opacity: .45; filter: grayscale(.6); }
  h3 { font-size: 1.25rem; margin-bottom: .2em; }
  h3 a { text-decoration: none; }
  .pot { color: var(--ink-soft); font-size: .95rem; margin-bottom: .6rem; }
  .foot { margin-top: auto; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px 12px; }
  .foot b { font-size: 1.15rem; font-weight: 500; }
</style>
