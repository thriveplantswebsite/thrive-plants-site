---
/* The two enquiry forms share everything except a few fields. See
   src/pages/api/enquiry.ts for where they go and how spam is stopped. */
interface Props { form: 'contact' | 'business' }
const { form } = Astro.props;
---
<form class="form" method="post" action="/api/enquiry" id="form" data-enquiry>
  <input type="hidden" name="form" value={form} />
  <input type="hidden" name="t" value="" data-started />
  <label class="hp" aria-hidden="true">Leave this empty <input name="website" tabindex="-1" autocomplete="off" /></label>

  <p class="error" role="alert" data-error hidden></p>

  <div class="form-row">
    <label class="field"><span>Your name</span><input name="name" required autocomplete="name" /></label>
    <label class="field"><span>Email</span><input name="email" type="email" required autocomplete="email" /></label>
  </div>

  {form === 'business' ? (
    <>
      <div class="form-row">
        <label class="field"><span>Business</span><input name="business" autocomplete="organization" /></label>
        <label class="field"><span>Phone (optional)</span><input name="phone" type="tel" autocomplete="tel" /></label>
      </div>
      <div class="form-row">
        <label class="field">
          <span>Type of space</span>
          <select name="space">
            <option>Office or studio</option><option>Restaurant</option><option>Café or bar</option><option>Shop or salon</option><option>Something else</option>
          </select>
        </label>
        <label class="field">
          <span>Roughly how many plants?</span>
          <select name="plants">
            <option>Not sure yet</option><option>1 to 10</option><option>10 to 30</option><option>30 or more</option>
          </select>
        </label>
      </div>
      <label class="field"><span>Tell us about it</span><textarea name="message" rows="5" required placeholder="Where you are in Bristol, what the light is like, what you have in mind."></textarea></label>
    </>
  ) : (
    <>
      <label class="field"><span>Phone (optional)</span><input name="phone" type="tel" autocomplete="tel" /></label>
      <label class="field"><span>Message</span><textarea name="message" rows="6" required placeholder="What's going on with your plant?"></textarea></label>
    </>
  )}

  <button class="btn" type="submit">Send</button>
</form>

<script>
  /* The "time on page" half of the spam check, and the error message for a
     form that bounced back. Without JavaScript the timestamp stays empty and
     the server treats the form as a bot's, so the one thing JavaScript-free
     visitors cannot do is send this form; they still have WhatsApp and the
     booking page, both linked right beside it. */
  document.querySelectorAll<HTMLFormElement>('[data-enquiry]').forEach((f) => {
    f.querySelector<HTMLInputElement>('[data-started]')!.value = String(Date.now());
    const err = new URLSearchParams(location.search).get('error');
    const box = f.querySelector<HTMLElement>('[data-error]')!;
    if (err) {
      box.hidden = false;
      box.textContent =
        err === 'missing'
          ? 'Please fill in your name, email and message.'
          : 'Sorry, that did not send. Please try again, or message us on WhatsApp.';
    }
    f.addEventListener('submit', () => {
      const b = f.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      b.disabled = true;
      b.textContent = 'Sending…';
    });
  });
</script>

<style>
  .error { color: var(--danger); margin: 0; }
</style>
