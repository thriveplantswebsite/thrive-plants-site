---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Page not found</span>
      <h1>This one's <em>wilted.</em></h1>
      <p class="lead">The page you were looking for isn't here. It may have been moved, or the plant may have been rehomed.</p>
      <div class="btn-row">
        <a href="/" class="btn">Back to the home page</a>
        <a href="/shop" class="btn btn-ghost">Visit the shop</a>
      </div>
    </div>
  </section>
</Base>
