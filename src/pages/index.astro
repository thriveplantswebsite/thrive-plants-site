---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { single } from '../lib/content';

const home = await single('homePage');
const settings = await single('settings');

/* Structured data so Google can show her as a local business. Only facts
   that are already public on her Instagram and booking page. */
const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'thrive plants bristol',
  description: settings.description,
  areaServed: 'Bristol',
  url: Astro.site?.href,
  sameAs: [settings.instagram].filter(Boolean),
};
---
<Base schema={schema}>
  <section class="hero">
    {home.heroImage && (
      <Image src={home.heroImage} alt="" class="hero-bg" widths={[640, 1024, 1600, 2400]} sizes="100vw" loading="eager" fetchpriority="high" />
    )}
    <div class="wrap hero-inner">
      {settings.instagram && (
        <a class="ig-pill" href={settings.instagram} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" /></svg>
          thriveplantsbristol
        </a>
      )}
      <h1>{home.heroLine1}<br /><em>{home.heroLine2}</em></h1>
      <p class="lead">{home.heroLead}</p>
      <div class="btn-row">
        <a href="/book" class="btn">Book your plant in</a>
        <a href="/hospital" class="btn btn-ghost">How it works</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><span class="eyebrow">How it works</span><h2>{home.stepsHeading}</h2></div>
      <ol class="steps">
        {home.steps.map((s, i) => (
          <li class="reveal">
            <span class="step-no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section band">
    <div class="wrap">
      <div class="section-head split">
        <div><span class="eyebrow">Plant hospital bingo</span><h2>{home.symptomsHeading}</h2></div>
        <p class="section-intro">{home.symptomsIntro}</p>
      </div>
      <div class="bingo">
        {home.symptoms.map((s, i) => (
          <a href="/book" class:list={['reveal', { win: i === home.symptoms.length - 1 }]}>
            <Icon name={s.icon} size={28} />
            <span>{s.label}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><span class="eyebrow">More from thrive</span><h2>{home.servicesHeading}</h2></div>
      <div class="tiles">
        {home.services.map((s) => (
          <a href={s.link || '/'} class="tile reveal">
            <div class="ph tile-img">
              {s.image ? (
                <Image src={s.image} alt="" widths={[400, 800]} sizes="(max-width: 560px) 100vw, (max-width: 1020px) 50vw, 25vw" />
              ) : (
                <div class="voucher-mini" aria-hidden="true">
                  <span class="label">Plant care gift voucher</span>
                  <span class="amt">£25</span>
                </div>
              )}
            </div>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
            {s.linkLabel && <span class="link-arrow">{s.linkLabel} <Icon name="arrow-right" /></span>}
          </a>
        ))}
      </div>
    </div>
  </section>

  {home.patients.length > 0 && (
    <section class="section band">
      <div class="wrap">
        <div class="section-head split">
          <div><span class="eyebrow">Case notes</span><h2>{home.patientsHeading}</h2></div>
          {settings.instagram && (
            <a class="link-arrow" href={settings.instagram} target="_blank" rel="noopener">More glow-ups on Instagram <Icon name="arrow-up-right" /></a>
          )}
        </div>
        <div class="patients">
          {home.patients.map((p) => (
            <figure class="patient reveal">
              <div class="ph">{p.image && <Image src={p.image} alt={p.title} widths={[400, 700]} sizes="(max-width: 1020px) 72vw, 25vw" />}</div>
              <figcaption><strong>{p.title}</strong><span>{p.note}</span></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap about">
      <div class="ph about-photo reveal">
        {home.aboutImage && <Image src={home.aboutImage} alt="Mandie among her houseplants" widths={[600, 1000]} sizes="(max-width: 860px) 100vw, 50vw" />}
      </div>
      <div>
        <span class="eyebrow">{home.aboutEyebrow}</span>
        <h2>{home.aboutHeading}</h2>
        <p class="lead">{home.aboutBody}</p>
        <a href="/about" class="btn btn-ghost">Read my story</a>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero { position: relative; min-height: min(88vh, 860px); display: flex; align-items: flex-end; overflow: hidden; color: #f4f0e6; }
  .hero :global(.hero-bg) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 35%; }
  .hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(15,20,16,.25) 0%, rgba(15,20,16,.35) 40%, rgba(15,20,16,.92) 100%); }
  .hero-inner { position: relative; z-index: 1; padding-block: 6rem clamp(3rem, 7vw, 6rem); }
  .hero h1 { margin-bottom: 0.35em; }
  .hero .lead { color: #e6e6da; }
  .ig-pill {
    display: inline-flex; align-items: center; gap: 8px; text-decoration: none;
    border: 1px solid rgba(244,240,230,.7); border-radius: 999px; padding: .45em 1.1em; font-size: .9rem; margin-bottom: 1.5rem;
  }
  .ig-pill svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); }
  .steps li { padding: 2.5rem 2rem 2rem 0; border-right: 1px solid var(--line); }
  .steps li + li { padding-left: 2rem; }
  .steps li:last-child { border-right: 0; }
  .step-no { display: block; font-family: var(--display); font-size: 4.5rem; line-height: 1; color: transparent; -webkit-text-stroke: 1.5px var(--lime); margin-bottom: 1rem; }
  .steps h3 { font-size: 2rem; }
  .steps p { color: var(--ink-soft); margin: 0; }
  @media (max-width: 860px) {
    .steps { grid-template-columns: 1fr; }
    .steps li, .steps li + li { border-right: 0; border-bottom: 1px solid var(--line); padding: 2rem 0; }
  }

  .bingo { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .bingo a {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; text-align: center;
    min-height: 132px; padding: 18px 12px; text-decoration: none;
    background: rgba(0,0,0,.18); border: 1px solid rgba(241,237,226,.25);
    font-family: var(--display); text-transform: uppercase; letter-spacing: .05em; line-height: 1.25;
    transition: background-color .2s, transform .15s var(--ease);
  }
  .bingo a :global(.icon) { color: var(--lime-bright); }
  .bingo a:hover { background: rgba(0,0,0,.35); transform: translateY(-3px); }
  .bingo .win { background: var(--lime-bright); color: var(--on-lime); border-color: var(--lime-bright); }
  .bingo .win :global(.icon) { color: var(--on-lime); }
  .bingo .win:hover { background: var(--lime); }
  @media (max-width: 760px) { .bingo { grid-template-columns: repeat(2, 1fr); } .bingo a { min-height: 112px; font-size: .92rem; } }

  .tiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .tile { text-decoration: none; display: flex; flex-direction: column; }
  .tile-img { aspect-ratio: 4 / 4.4; margin-bottom: 1.25rem; }
  .tile h3 { font-size: 1.6rem; }
  .tile p { color: var(--ink-soft); font-size: 1rem; }
  .tile .link-arrow { margin-top: auto; }
  .voucher-mini {
    width: 100%; height: 100%; display: grid; align-content: center; justify-items: start; gap: 6px;
    padding: 18% 14%; background: var(--band);
  }
  .voucher-mini .label { color: var(--ink-on-band); }
  .voucher-mini .amt { font-family: var(--display); font-size: 3.4rem; line-height: 1; color: var(--lime-bright); }
  @media (max-width: 1020px) { .tiles { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .tiles { grid-template-columns: 1fr; gap: 32px; } .tile-img { aspect-ratio: 4 / 3; } }

  .patients { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .patient { margin: 0; }
  .patient .ph { aspect-ratio: 4 / 5; margin-bottom: 1rem; }
  .patient figcaption { display: flex; flex-direction: column; gap: 2px; }
  .patient strong { font-family: var(--display); font-weight: 600; text-transform: uppercase; font-size: 1.25rem; line-height: 1.2; }
  .patient span { color: var(--ink-on-band); font-size: .97rem; }
  @media (max-width: 1020px) {
    .patients { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 72%; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 12px; margin-right: -16px; padding-right: 16px; }
    .patient { scroll-snap-align: start; }
  }
  @media (min-width: 700px) and (max-width: 1020px) { .patients { grid-auto-columns: 40%; } }

  .about { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 6vw, 6rem); align-items: center; }
  .about-photo { aspect-ratio: 4 / 3.3; }
  .about-photo :global(img) { object-position: 45% 70%; }
  .about .lead { margin-bottom: 1.5rem; }
  @media (max-width: 860px) { .about { grid-template-columns: 1fr; } }
</style>
